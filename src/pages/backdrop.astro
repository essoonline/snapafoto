---
import MainLayout from '@/layouts/MainLayout.astro';
import type { ImageMetadata } from 'astro';
import { SITE } from '@/data_files/constants';

const pageTitle: string = `ฉากหลัง | ${SITE.title}`;
const metaDescription = '';
const ogTitle = 'ฉากหลัง | SNAP a FOTO';

const backdropImages = Object.entries(
  import.meta.glob('../images/backdrop/*.webp', {
    eager: true,
    import: 'default',
  }) as Record<string, ImageMetadata>
)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([path, image], index) => ({
    src: image.src,
    alt: `Backdrop image ${index + 1} (${path.split('/').pop()})`,
  }));
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${SITE.url}/backdrop`,
    url: `${SITE.url}/backdrop`,
    name: ogTitle,
    description: metaDescription,
    isPartOf: {
      '@type': 'WebSite',
      url: SITE.url,
      name: SITE.title,
      description: SITE.description,
    },
    inLanguage: 'th-TH',
  }}
>
  <section class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {
        backdropImages.map((image) => (
          <div class="overflow-hidden border border-neutral-200 bg-white">
            <button
              type="button"
              class="block h-full w-full cursor-zoom-in"
              data-lightbox-src={image.src}
              data-lightbox-alt={image.alt}
              aria-label={`Open ${image.alt} in full size`}
            >
              <img
                src={image.src}
                alt={image.alt}
                loading="lazy"
                class="h-full w-full object-cover"
              />
            </button>
          </div>
        ))
      }
    </div>
  </section>

  <div
    id="backdrop-lightbox"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/85 p-4"
    role="dialog"
    aria-modal="true"
    aria-label="Expanded backdrop image"
  >
    <button
      type="button"
      id="backdrop-lightbox-close"
      class="absolute right-4 top-4 border border-white/60 px-3 py-1 text-sm text-white"
      aria-label="Close image preview"
    >
      Close
    </button>
    <img
      id="backdrop-lightbox-image"
      src=""
      alt=""
      class="max-h-[92vh] max-w-[95vw] object-contain"
    />
  </div>

  <script>
    (() => {
      const overlay = document.querySelector<HTMLElement>('#backdrop-lightbox');
      const lightboxImage =
        document.querySelector<HTMLImageElement>('#backdrop-lightbox-image');
      const closeButton = document.querySelector<HTMLElement>('#backdrop-lightbox-close');
      const triggers = document.querySelectorAll<HTMLElement>('[data-lightbox-src]');

      if (!overlay || !lightboxImage || !closeButton || triggers.length === 0) {
        return;
      }

      const openLightbox = (src: string, alt: string) => {
        lightboxImage.src = src;
        lightboxImage.alt = alt;
        overlay.classList.remove('hidden');
        overlay.classList.add('flex');
        document.body.style.overflow = 'hidden';
      };

      const closeLightbox = () => {
        overlay.classList.add('hidden');
        overlay.classList.remove('flex');
        document.body.style.overflow = '';
      };

      triggers.forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const src = trigger.getAttribute('data-lightbox-src');
          const alt = trigger.getAttribute('data-lightbox-alt') || 'Backdrop image';
          if (!src) return;
          openLightbox(src, alt);
        });
      });

      closeButton.addEventListener('click', closeLightbox);

      overlay.addEventListener('click', (event) => {
        if (event.target === overlay) {
          closeLightbox();
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !overlay.classList.contains('hidden')) {
          closeLightbox();
        }
      });
    })();
  </script>
</MainLayout>
