---
// Import necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import MainSection from '@components/ui/blocks/MainSection.astro';
import LeftSection from '@components/ui/blocks/LeftSection.astro';
import RightSection from '@components/ui/blocks/RightSection.astro';
import FeaturesStats from '@components/sections/features/FeaturesStats.astro';

// Import necessary images
import blueprints from '@images/features-image.webp';
import personWorking from '@images/hero-image.webp';
import hero360 from '@images/hero-360.webp';
import constructionWorkers from '@images/guestbook-features1.webp';
import aerialView from '@images/guestbook-features2.webp';
import usingTools from '@images/photobooth-features1.webp';
import progressBuilding from '@images/photobooth-features2.webp';
import underConstruction from '@images/photobooth-features3.webp';
import { SITE } from '@data/constants';

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: 'โฟโต้บูธมาตรฐาน: ถ่ายสนุก ปริ้นไว พร้อมทีมงานดูแล',
    subTitle:
      'บริการโฟโต้บูธของ SNAP a FOTO ออกแบบมาให้ใช้งานง่ายและสนุกสำหรับแขกทุกวัย ถ่ายภาพได้ไม่อั้น พร้อมปริ้นท์ภาพหน้างานและไฟล์ดิจิทัลกลับบ้านทันที เหมาะกับงานแต่ง งานเลี้ยงบริษัท และอีเวนต์ทุกรูปแบบ โดยมีทีมงานคอยดูแลอุปกรณ์และลำดับคิวตลอดงาน',
    single: false,
    imgOne: blueprints,
    imgOneAlt: 'โซนโฟโต้บูธพร้อมอุปกรณ์หน้างาน',
    imgTwo: personWorking,
    imgTwoAlt: 'แขกกำลังใช้งานโฟโต้บูธในงานอีเวนต์',
    btnExists: true,
    btnTitle: 'ดูรายละเอียด โฟโต้บูธ',
    btnURL: '/',
  },
  {
    isRightSection: false,
    title: '360 องศา: วิดีโอหมุนรอบสุดว้าวที่แชร์ได้ทันที',
    subTitle:
      'เพิ่มความโดดเด่นให้งานของคุณด้วย 360 Photo Booth ที่บันทึกวิดีโอแบบ Slow Motion พร้อมเอฟเฟกต์และเพลงประกอบ แขกเพียงขึ้นแท่นและโพสท่า ระบบจะประมวลผลและส่งต่อผ่าน QR Code ได้ในไม่กี่วินาที เหมาะกับงานเปิดตัวสินค้า งานบริษัท และงานปาร์ตี้ที่ต้องการคอนเทนต์ไวรัล',
    img: hero360,
    imgAlt: 'บริการ 360 องศาในงานอีเวนต์',
    btnExists: true,
    btnTitle: 'ดูรายละเอียด 360 องศา',
    btnURL: '/360',
  },
  {
    isRightSection: true,
    title: 'วีดีโออวยพร: เก็บทุกคำอวยพรแบบมีชีวิต',
    subTitle:
      'Video Guest Book ช่วยบันทึกข้อความจากคนสำคัญในรูปแบบวิดีโอ ทั้งเสียง สีหน้า และอารมณ์ที่ภาพนิ่งแทนไม่ได้ แขกใช้งานง่ายผ่านหน้าจอแนะนำทีละขั้นตอน และหลังจบงานสามารถรับไฟล์รวมเพื่อนำไปตัดต่อหรือเก็บเป็นที่ระลึก เหมาะอย่างยิ่งสำหรับงานแต่งและงานเฉลิมฉลองสำคัญ',
    single: false,
    imgOne: constructionWorkers,
    imgOneAlt: 'แขกกำลังอัดวีดีโออวยพร',
    imgTwo: aerialView,
    imgTwoAlt: 'ตัวอย่างวิดีโอคำอวยพรจากแขก',
    btnExists: true,
    btnTitle: 'ดูรายละเอียด Video Guest Book',
    btnURL: '/guestbook',
  },
  {
    isRightSection: false,
    title: 'ทีมงานมืออาชีพ: ดูแลหน้างานครบตั้งแต่เริ่มจนจบ',
    subTitle:
      'ไม่ว่าจะเลือกโฟโต้บูธ, 360 องศา หรือวีดีโออวยพร ทีมงาน SNAP a FOTO จะดูแลการติดตั้ง ทดสอบระบบ และซัพพอร์ตหน้างานแบบใกล้ชิด เพื่อให้เจ้าภาพโฟกัสกับบรรยากาศงานได้เต็มที่ โดยไม่ต้องกังวลเรื่องเทคนิคหรืออุปกรณ์',
    img: usingTools,
    imgAlt:
      'ทีมงาน SNAP a FOTO ดูแลอุปกรณ์หน้างาน',
  },
  {
    isRightSection: true,
    title: 'แพ็กเกจยืดหยุ่น: เลือกให้เหมาะกับพื้นที่และงบประมาณ',
    subTitle:
      'เรามีหลายแพ็กเกจให้เลือกตามขนาดงานและวัตถุประสงค์ พร้อมปรับธีมกรอบภาพ โทนวิดีโอ และรูปแบบประสบการณ์ให้เข้ากับงานของคุณโดยเฉพาะ หากต้องการคำแนะนำ ทีมงานพร้อมช่วยวางแผนเพื่อให้ได้บริการที่คุ้มค่าและเหมาะสมที่สุด',
    single: false,
    imgOne: progressBuilding,
    imgOneAlt: 'ตัวอย่างแพ็กเกจบริการโฟโต้บูธและ 360',
    imgTwo: underConstruction,
    imgTwoAlt: 'ทีมงานเตรียมความพร้อมก่อนเริ่มงาน',
  },
];

const pageTitle: string = `Services | ${SITE.title}`;
const metaDescription =
  'รวมบริการหลักจาก SNAP a FOTO ทั้งโฟโต้บูธ 360 องศา และวีดีโออวยพร พร้อมทีมงานดูแลหน้างานแบบมืออาชีพ เหมาะสำหรับงานแต่ง งานบริษัท และอีเวนต์ทุกประเภท';
const ogTitle = `บริการทั้งหมด | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${SITE.url}/services`,
    url: `${SITE.url}/services`,
    name: ogTitle,
    description: metaDescription,
    isPartOf: {
      '@type': 'WebSite',
      url: SITE.url,
      name: SITE.title,
      description: SITE.description,
    },
    inLanguage: 'th-TH',
  }}
>
  {
    /* MainSection is the introductory section of the page, it also contains a CTA button */
  }
  <section class="mx-auto max-w-340 px-4 pt-10 pb-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl overflow-hidden rounded-2xl border border-neutral-300 bg-neutral-100 shadow-sm">
      <div class="aspect-video w-full relative" id="video-cover-container">
        <script type="text/javascript">
          function loadVideo() {
            const container = document.getElementById('video-cover-container');
            container.innerHTML = `<iframe
              class='h-full w-full'
              src='https://www.youtube-nocookie.com/embed/4PyiaFEUPnY?autoplay=1'
              title='PhotoBooth video presentation'
              loading='lazy'
              allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
              referrerpolicy='strict-origin-when-cross-origin'
              allowfullscreen
            ></iframe>`;
          }
        </script>
        <button type="button" onclick="loadVideo()" class="absolute inset-0 w-full h-full focus:outline-none group">
          <img src="https://img.youtube.com/vi/4PyiaFEUPnY/maxresdefault.jpg" alt="PhotoBooth video cover" class="h-full w-full object-cover rounded-2xl border-0" loading="lazy" />
          <span class="absolute inset-0 flex items-center justify-center">
            <svg class="w-20 h-20 text-white/80 group-hover:text-yellow-400 transition" fill="currentColor" viewBox="0 0 84 84">
              <circle cx="42" cy="42" r="42" fill="black" fill-opacity="0.5"/>
              <polygon points="34,28 62,42 34,56" fill="white"/>
            </svg>
          </span>
        </button>
      </div>
    </div>
  </section>
  {
    /* RightSection and LeftSection contain details about various services along with pertinent imagery.
  They alternate for variety in design.
  The 'btnExists' property is used to toggle the display of a button in these sections.
  When btnExists={true}, a button is displayed.
  This can be used to link to more detailed information or related resources.
  RightSection can also conditionally render one or two images based on the 'single' property.
  If 'single' is true, it displays one image, otherwise it displays two.
  */
  }
  {
    articles.map(article => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }
  {/* FeaturesStats section showcases essential stats valuable to users */}
  <FeaturesStats
    title="ภาพรวมบริการของเรา"
    subTitle="บริการของ SNAP a FOTO ถูกออกแบบให้ตอบโจทย์งานหลากหลายรูปแบบ ตั้งแต่งานเล็กแบบอบอุ่นไปจนถึงอีเวนต์ขนาดใหญ่ที่ต้องการประสบการณ์น่าประทับใจ"
    mainStatTitle="96%"
    mainStatSubTitle="ของลูกค้าให้คะแนนประสบการณ์โดยรวมว่าเกินความคาดหวัง"
    stats={[
      {
        stat: '3 บริการหลัก',
        description: 'โฟโต้บูธ, 360 องศา, วีดีโออวยพร',
      },
      {
        stat: 'ดูแลครบหน้างาน',
        description: 'ติดตั้ง ทดสอบ และซัพพอร์ตตลอดงาน',
      },
      {
        stat: 'ปรับแพ็กเกจได้',
        description: 'เลือกให้เหมาะกับงบประมาณและพื้นที่งาน',
      },
    ]}
  />
</MainLayout>
