---
import MainLayout from '@/layouts/MainLayout.astro';
import LegalSection from '@components/sections/misc/LegalSection.astro';
import PrivacyPolicyTh from '@components/sections/misc/legal/PrivacyPolicyTh.astro';
import { SITE } from '@data/constants';

const pageTitle = `นโยบายความเป็นส่วนตัว | ${SITE.title}`;
const metaDescription =
  'นโยบายความเป็นส่วนตัวของ SNAP a FOTO บริการเช่าโฟโต้บูธและตู้ถ่ายรูปสำหรับงานแต่งงานและอีเว้นท์';
const ogTitle = `นโยบายความเป็นส่วนตัว | SNAP a FOTO`;
const lastUpdated = '19 มิถุนายน 2569';
---

<MainLayout
  title={pageTitle}
  lang="th"
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${SITE.url}/privacy-policy`,
    url: `${SITE.url}/privacy-policy`,
    name: ogTitle,
    description: metaDescription,
    isPartOf: {
      '@type': 'WebSite',
      url: SITE.url,
      name: SITE.title,
      description: SITE.description,
    },
    inLanguage: 'th-TH',
  }}
>
  <LegalSection
    title="นโยบายความเป็นส่วนตัว"
    lastUpdated={lastUpdated}
    alternateLang={{ label: 'English', url: '/en/privacy-policy' }}
  >
    <PrivacyPolicyTh />
  </LegalSection>
</MainLayout>
