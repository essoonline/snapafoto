---
import MainLayout from '@/layouts/MainLayout.astro';
import LegalSection from '@components/sections/misc/LegalSection.astro';
import { SITE } from '@data/constants';

const pageTitle = `นโยบายความเป็นส่วนตัว | ${SITE.title}`;
const metaDescription =
  'นโยบายความเป็นส่วนตัวของ SNAP a FOTO บริการเช่าโฟโต้บูธและตู้ถ่ายรูปสำหรับงานแต่งงานและอีเว้นท์';
const ogTitle = `นโยบายความเป็นส่วนตัว | SNAP a FOTO`;
const lastUpdated = '19 มิถุนายน 2569';
---

<MainLayout
  title={pageTitle}
  lang="th"
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${SITE.url}/privacy-policy`,
    url: `${SITE.url}/privacy-policy`,
    name: ogTitle,
    description: metaDescription,
    isPartOf: {
      '@type': 'WebSite',
      url: SITE.url,
      name: SITE.title,
      description: SITE.description,
    },
    inLanguage: 'th-TH',
  }}
>
  <LegalSection title="นโยบายความเป็นส่วนตัว" lastUpdated={lastUpdated}>
    <p>
      นโยบายความเป็นส่วนตัวฉบับนี้ ("นโยบาย") อธิบายวิธีที่ <strong>SNAP a FOTO</strong>
      ("เรา" "บริษัท") เก็บรวบรวม ใช้ เปิดเผย และคุ้มครองข้อมูลส่วนบุคคลของท่าน
      เมื่อท่านใช้งานเว็บไซต์ <a href={SITE.url}>{SITE.url}</a> บริการเช่าโฟโต้บูธ
      ตู้ถ่ายรูป 360 องศา Video Guestbook AI Photobooth แพลตฟอร์ม Cloud
      และช่องทางติดต่ออื่น ๆ ของเรา
    </p>
    <p>
      เราให้ความสำคัญกับความเป็นส่วนตัวของท่านและปฏิบัติตามพระราชบัญญัติคุ้มครองข้อมูลส่วนบุคคล
      พ.ศ. 2562 (PDPA) ตามที่เกี่ยวข้อง
    </p>

    <h2>1. ผู้ควบคุมข้อมูลส่วนบุคคล</h2>
    <p>
      <strong>SNAP a FOTO</strong><br />
      อีเมล: <a href="mailto:snapafoto@yahoo.com">snapafoto@yahoo.com</a><br />
      โทรศัพท์: <a href="tel:0882667544">088-266-7544</a><br />
      LINE Official: @snapafoto<br />
      เว็บไซต์: <a href={SITE.url}>{SITE.url}</a>
    </p>

    <h2>2. ข้อมูลที่เราเก็บรวบรวม</h2>
    <p>เราอาจเก็บรวบรวมข้อมูลดังต่อไปนี้:</p>
    <h3>2.1 ข้อมูลที่ท่านให้โดยตรง</h3>
    <ul>
      <li>ชื่อ-นามสกุล ชื่อบริษัท หรือชื่อองค์กร</li>
      <li>หมายเลขโทรศัพท์ อีเมล และช่องทางติดต่ออื่น ๆ (เช่น LINE ID)</li>
      <li>รายละเอียดงานอีเวนต์ เช่น วันที่ สถานที่ ประเภทงาน และความต้องการพิเศษ</li>
      <li>ข้อมูลการชำระเงินและใบเสร็จ (เราไม่เก็บข้อมูลบัตรเครดิตโดยตรงบนเว็บไซต์)</li>
      <li>ข้อความหรือคำถามที่ท่านส่งผ่านแบบฟอร์มติดต่อ อีเมล หรือโซเชียลมีเดีย</li>
    </ul>
    <h3>2.2 ข้อมูลจากการใช้บริการโฟโต้บูธ</h3>
    <ul>
      <li>ภาพถ่าย วิดีโอ หรือเสียงที่บันทึกผ่านอุปกรณ์ของเราในงานอีเวนต์</li>
      <li>ข้อมูลการดาวน์โหลดรูปผ่าน QR Code หรือแพลตฟอร์ม Cloud</li>
      <li>ข้อมูลจากระบบ AI Photobooth (เช่น ภาพที่ประมวลผลด้วย AI)</li>
      <li>ข้อความหรือคำอวยพรที่บันทึกใน Video Guestbook</li>
    </ul>
    <h3>2.3 ข้อมูลทางเทคนิค</h3>
    <ul>
      <li>ที่อยู่ IP ประเภทเบราว์เซอร์ อุปกรณ์ และระบบปฏิบัติการ</li>
      <li>ข้อมูลการเข้าชมเว็บไซต์ หน้าที่เข้าชม และเวลาที่ใช้บนเว็บไซต์</li>
      <li>คุกกี้และเทคโนโลยีที่คล้ายกัน (ดูรายละเอียดในหัวข้อ 7)</li>
    </ul>

    <h2>3. วัตถุประสงค์ในการใช้ข้อมูล</h2>
    <p>เราใช้ข้อมูลส่วนบุคคลเพื่อ:</p>
    <ul>
      <li>ให้บริการเช่าโฟโต้บูธ ติดตั้งอุปกรณ์ และดำเนินงานในงานอีเวนต์</li>
      <li>ติดต่อสื่อสาร ยืนยันการจอง ส่งใบเสนอราคา และประสานงานก่อน-หลังงาน</li>
      <li>จัดเก็บและแชร์ภาพถ่าย/วิดีโอให้แขกในงานผ่าน QR Code หรือ Cloud</li>
      <li>ออกแบบกรอบรูปและปรับแต่งบริการตามความต้องการของลูกค้า</li>
      <li>ปรับปรุงเว็บไซต์ วิเคราะห์การใช้งาน และพัฒนาบริการ</li>
      <li>ปฏิบัติตามกฎหมาย ข้อบังคับ และคำสั่งของหน่วยงานที่เกี่ยวข้อง</li>
      <li>ป้องกันการฉ้อโกงและรักษาความปลอดภัยของระบบ</li>
    </ul>

    <h2>4. ฐานทางกฎหมายในการประมวลผลข้อมูล</h2>
    <p>เราประมวลผลข้อมูลส่วนบุคคลบนฐานทางกฎหมายดังต่อไปนี้:</p>
    <ul>
      <li><strong>สัญญา</strong> — เพื่อให้บริการตามที่ท่านจองหรือร้องขอ</li>
      <li><strong>ความยินยอม</strong> — เช่น การสมัครรับข่าวสาร หรือการถ่ายภาพ/วิดีโอในงาน</li>
      <li><strong>ประโยชน์โดยชอบด้วยกฎหมาย</strong> — เช่น การปรับปรุงบริการและความปลอดภัยของระบบ</li>
      <li><strong>หน้าที่ตามกฎหมาย</strong> — เช่น การเก็บรักษาบัญชีและเอกสารทางการเงิน</li>
    </ul>

    <h2>5. การเปิดเผยข้อมูลต่อบุคคลที่สาม</h2>
    <p>เราอาจเปิดเผยข้อมูลให้กับ:</p>
    <ul>
      <li>ทีมงานและผู้ให้บริการที่เกี่ยวข้องกับการดำเนินงานของเรา</li>
      <li>ผู้ให้บริการโฮสติ้ง Cloud ระบบจัดเก็บรูปภาพ และเครื่องมือวิเคราะห์เว็บไซต์</li>
      <li>แพลตฟอร์มโซเชียลมีเดียที่ท่านเลือกใช้ติดต่อเรา (เช่น Facebook, LINE, Instagram)</li>
      <li>หน่วยงานราชการเมื่อกฎหมายกำหนด</li>
    </ul>
    <p>
      เราไม่ขายข้อมูลส่วนบุคคลของท่านให้กับบุคคลที่สาม
      สำหรับภาพถ่ายและวิดีโอในงานอีเวนต์ ลูกค้าที่จัดงานอาจเป็นผู้กำหนดนโยบายการใช้งานเพิ่มเติม
      โดยเราจะดำเนินการตามข้อตกลงกับลูกค้าผู้จัดงาน
    </p>

    <h2>6. การเก็บรักษาข้อมูล</h2>
    <p>
      เราเก็บรักษาข้อมูลส่วนบุคคลเท่าที่จำเป็นเพื่อวัตถุประสงค์ที่ระบุในนโยบายนี้
      โดยทั่วไป:
    </p>
    <ul>
      <li>ข้อมูลการจองและติดต่อ — ตามระยะเวลาที่กฎหมายกำหนดหรือตามความจำเป็นทางธุรกิจ</li>
      <li>ภาพถ่ายและวิดีโอบน Cloud — ตามระยะเวลาที่ระบุในสัญญาหรือแพ็กเกจบริการ</li>
      <li>ข้อมูลทางเทคนิคและคุกกี้ — ตามระยะเวลาที่กำหนดในแต่ละประเภท</li>
    </ul>
    <p>
      เมื่อหมดความจำเป็น เราจะลบหรือทำให้ข้อมูลไม่สามารถระบุตัวบุคคลได้
      เว้นแต่กฎหมายกำหนดให้เก็บรักษาต่อไป
    </p>

    <h2>7. คุกกี้และเทคโนโลยีติดตาม</h2>
    <p>
      เว็บไซต์ของเราอาจใช้คุกกี้เพื่อจดจำการตั้งค่า วิเคราะห์การเข้าชม
      และปรับปรุงประสบการณ์การใช้งาน ท่านสามารถตั้งค่าเบราว์เซอร์เพื่อปฏิเสธคุกกี้ได้
      แต่อาจส่งผลต่อการใช้งานบางส่วนของเว็บไซต์
    </p>

    <h2>8. ความปลอดภัยของข้อมูล</h2>
    <p>
      เราใช้มาตรการทางเทคนิคและการบริหารจัดการที่เหมาะสมเพื่อปกป้องข้อมูลส่วนบุคคล
      จากการเข้าถึง การใช้ การเปลี่ยนแปลง หรือการเปิดเผยโดยไม่ได้รับอนุญาต
      อย่างไรก็ตาม ไม่มีระบบใดที่ปลอดภัยได้อย่างสมบูรณ์ 100%
    </p>

    <h2>9. สิทธิของเจ้าของข้อมูล</h2>
    <p>ภายใต้ PDPA ท่านมีสิทธิ:</p>
    <ul>
      <li>ขอเข้าถึงและขอสำเนาข้อมูลส่วนบุคคลของท่าน</li>
      <li>ขอแก้ไขข้อมูลให้ถูกต้อง ครบถ้วน และเป็นปัจจุบัน</li>
      <li>ขอให้ลบหรือทำลายข้อมูลเมื่อหมดความจำเป็น</li>
      <li>ขอระงับการใช้ข้อมูลในบางกรณี</li>
      <li>ถอนความยินยอมเมื่อการประมวลผลอาศัยความยินยอม</li>
      <li>คัดค้านการประมวลผลในบางกรณีตามที่กฎหมายกำหนด</li>
    </ul>
    <p>
      หากท่านต้องการใช้สิทธิ กรุณาติดต่อเราที่
      <a href="mailto:snapafoto@yahoo.com">snapafoto@yahoo.com</a>
      เราจะดำเนินการภายในระยะเวลาที่กฎหมายกำหนด
    </p>

    <h2>10. ข้อมูลของเด็ก</h2>
    <p>
      บริการของเรามักใช้ในงานอีเวนต์ที่มีผู้เข้าร่วมทุกวัย
      หากมีการถ่ายภาพเด็กในงาน การใช้งานภาพดังกล่าวควรได้รับความยินยอมจากผู้ปกครองหรือผู้จัดงาน
      ตามที่เหมาะสม
    </p>

    <h2>11. ลิงก์ไปยังเว็บไซต์อื่น</h2>
    <p>
      เว็บไซต์ของเราอาจมีลิงก์ไปยังเว็บไซต์หรือบริการของบุคคลที่สาม
      (เช่น Facebook, YouTube, LINE) เราไม่รับผิดชอบต่อนโยบายความเป็นส่วนตัวของเว็บไซต์เหล่านั้น
      กรุณาอ่านนโยบายของแต่ละเว็บไซต์ก่อนให้ข้อมูล
    </p>

    <h2>12. การเปลี่ยนแปลงนโยบาย</h2>
    <p>
      เราอาจปรับปรุงนโยบายนี้เป็นครั้งคราว การเปลี่ยนแปลงจะมีผลเมื่อเผยแพร่บนหน้านี้
      โดยจะระบุวันที่อัปเดตล่าสุดไว้ด้านบน
      หากมีการเปลี่ยนแปลงที่สำคัญ เราอาจแจ้งผ่านเว็บไซต์หรือช่องทางติดต่อที่เหมาะสม
    </p>

    <h2>13. ติดต่อเรา</h2>
    <p>
      หากมีคำถามเกี่ยวกับนโยบายความเป็นส่วนตัวนี้ กรุณาติดต่อ:
    </p>
    <p>
      <strong>SNAP a FOTO</strong><br />
      อีเมล: <a href="mailto:snapafoto@yahoo.com">snapafoto@yahoo.com</a><br />
      โทรศัพท์: <a href="tel:0882667544">088-266-7544</a><br />
      LINE: @snapafoto<br />
      เว็บไซต์: <a href="/contact">ติดต่อเรา</a>
    </p>
  </LegalSection>
</MainLayout>
