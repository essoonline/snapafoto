---
import MainLayout from '@/layouts/MainLayout.astro';
import LegalSection from '@components/sections/misc/LegalSection.astro';
import { SITE } from '@data/constants';

const pageTitle = `ข้อกำหนดการให้บริการ | ${SITE.title}`;
const metaDescription =
  'ข้อกำหนดและเงื่อนไขการให้บริการเช่าโฟโต้บูธ ตู้ถ่ายรูป และบริการอีเวนต์ของ SNAP a FOTO';
const ogTitle = `ข้อกำหนดการให้บริการ | SNAP a FOTO`;
const lastUpdated = '19 มิถุนายน 2569';
---

<MainLayout
  title={pageTitle}
  lang="th"
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${SITE.url}/terms-of-service`,
    url: `${SITE.url}/terms-of-service`,
    name: ogTitle,
    description: metaDescription,
    isPartOf: {
      '@type': 'WebSite',
      url: SITE.url,
      name: SITE.title,
      description: SITE.description,
    },
    inLanguage: 'th-TH',
  }}
>
  <LegalSection title="ข้อกำหนดการให้บริการ" lastUpdated={lastUpdated}>
    <p>
      ข้อกำหนดการให้บริการฉบับนี้ ("ข้อกำหนด") กำหนดเงื่อนไขการใช้บริการของ
      <strong>SNAP a FOTO</strong> ("เรา" "บริษัท") ซึ่งให้บริการเช่าโฟโต้บูธ
      ตู้ถ่ายรูป 360 องศา Video Guestbook AI Photobooth บริการพิมพ์ภาพทันที
      และโซลูชันถ่ายภาพสำหรับงานแต่งงาน อีเวนต์ ปาร์ตี้ และกิจกรรมต่าง ๆ
    </p>
    <p>
      การจองหรือใช้บริการของเรา ถือว่าท่าน ("ลูกค้า") ได้อ่าน เข้าใจ
      และยอมรับข้อกำหนดนี้ รวมถึง
      <a href="/privacy-policy">นโยบายความเป็นส่วนตัว</a> ของเรา
    </p>

    <h2>1. บริการที่ให้</h2>
    <p>เราให้บริการดังต่อไปนี้ (ขึ้นอยู่กับแพ็กเกจที่เลือก):</p>
    <ul>
      <li>โฟโต้บูธ / ตู้ถ่ายรูป — ถ่ายภาพและพิมพ์รูปทันที ไม่จำกัดจำนวน (ตามแพ็กเกจ)</li>
      <li>360 VDO Booth — บันทึกวิดีโอ 360 องศา</li>
      <li>Video Guestbook — บันทึกวิดีโอคำอวยพรจากแขกในงาน</li>
      <li>AI Photobooth — ระบบถ่ายภาพด้วยเทคโนโลยี AI</li>
      <li>บริการเสริม — ออกแบบกรอบรูป พร็อพถ่ายรูป ไฟสตูดิโอ ระบบ QR Code และ Cloud Gallery</li>
    </ul>
    <p>
      รายละเอียดบริการ ระยะเวลา ราคา และสิ่งที่รวมในแพ็กเกจจะระบุในใบเสนอราคา
      หรือการยืนยันการจองที่ตกลงกันเป็นลายลักษณ์อักษรหรือผ่านช่องทางอิเล็กทรอนิกส์
    </p>

    <h2>2. การจองและการชำระเงิน</h2>
    <ul>
      <li>การจองจะสมบูรณ์เมื่อลูกค้ายืนยันรายละเอียดงานและชำระเงินมัดจำตามที่ตกลง</li>
      <li>ราคาที่แสดงบนเว็บไซต์เป็นราคาเริ่มต้น อาจปรับตามสถานที่ ระยะทาง วันที่ และความต้องการพิเศษ</li>
      <li>ลูกค้าต้องชำระยอดคงเหลือ (หากมี) ภายในระยะเวลาที่ตกลงก่อนวันงาน</li>
      <li>หากลูกค้าชำระเงินล่าช้า เราอาจระงับหรือยกเลิกการให้บริการได้</li>
    </ul>

    <h2>3. การยกเลิกและการเลื่อนนัด</h2>
    <ul>
      <li>
        <strong>ยกเลิกก่อน 30 วัน</strong> — คืนเงินมัดจำเต็มจำนวน (หักค่าใช้จ่ายที่เกิดขึ้นจริง หากมี)
      </li>
      <li>
        <strong>ยกเลิก 15–29 วันก่อนงาน</strong> — คืนเงินมัดจำ 50% หรือเลื่อนวันได้ 1 ครั้ง (ภายใน 6 เดือน)
      </li>
      <li>
        <strong>ยกเลิกน้อยกว่า 14 วันก่อนงาน</strong> — ไม่คืนเงินมัดจำ แต่อาจพิจารณาเลื่อนวันตามความเหมาะสม
      </li>
      <li>
        การเลื่อนวันต้องแจ้งล่วงหน้าและขึ้นอยู่กับคิวว่างของเรา
        หากไม่สามารถเลื่อนได้ จะใช้เงื่อนไขการยกเลิกตามช่วงเวลาที่แจ้ง
      </li>
      <li>
        กรณีเหตุสุดวิสัย (เช่น ภัยธรรมชาติ การระบาด หรือคำสั่งของรัฐ)
        ทั้งสองฝ่ายจะประสานงานเพื่อหาทางออกที่เหมาะสม
      </li>
    </ul>
    <p>
      เงื่อนไขเฉพาะอาจระบุเพิ่มเติมในใบเสนอราคาหรือสัญญาแต่ละรายการ
      หากมีข้อขัดแย้ง ให้ใช้เงื่อนไขในเอกสารการจองเป็นหลัก
    </p>

    <h2>4. หน้าที่ของลูกค้า</h2>
    <p>ลูกค้าตกลงที่จะ:</p>
    <ul>
      <li>จัดเตรียมพื้นที่ติดตั้งอุปกรณ์ตามขนาดที่ตกลง (โดยทั่วไปไม่น้อยกว่า 2×2 เมตร)</li>
      <li>จัดหาแหล่งไฟฟ้า 220V ใกล้จุดติดตั้ง (อย่างน้อย 1 จุด)</li>
      <li>อนุญาตให้ทีมงานเข้าถึงสถานที่ล่วงหน้าตามเวลาที่ตกลงเพื่อติดตั้งและทดสอบระบบ</li>
      <li>แจ้งรายละเอียดสถานที่ การจราจร ข้อจำกัดของสถานที่ และความต้องการพิเศษล่วงหน้า</li>
      <li>ดูแลความปลอดภัยของอุปกรณ์ระหว่างงานจากแขกที่ใช้บริการอย่างไม่เหมาะสม (เช่น ทำลายหรือทำตก)</li>
      <li>ได้รับความยินยอมจากผู้เข้าร่วมงานในการถ่ายภาพ/วิดีโอ ตามที่เหมาะสม</li>
    </ul>

    <h2>5. การให้บริการและเวลาทำงาน</h2>
    <ul>
      <li>ระยะเวลาให้บริการนับตามแพ็กเกจที่จอง (เช่น 2, 3 หรือ 4 ชั่วโมง)</li>
      <li>เวลาเริ่มนับเมื่ออุปกรณ์พร้อมใช้งานและลูกค้ายืนยันให้เริ่มบริการ</li>
      <li>การติดตั้งและทดสอบก่อนงานไม่นับรวมในเวลาให้บริการ เว้นแต่ตกลงเป็นอย่างอื่น</li>
      <li>หากลูกค้าขอให้เริ่มก่อนเวลาที่ตกลง อาจมีค่าใช้จ่ายเพิ่มเติม</li>
      <li>การขยายเวลาเพิ่มเติมสามารถทำได้หากทีมงานว่าง และมีค่าใช้จ่ายตามอัตราที่ตกลง</li>
    </ul>

    <h2>6. สิทธิในภาพถ่ายและวิดีโอ</h2>
    <ul>
      <li>
        ภาพถ่ายและวิดีโอที่บันทึกในงานเป็นทรัพย์สินของลูกค้าผู้จัดงาน
        ลูกค้ามีสิทธิใช้งานเพื่อวัตถุประสงค์ส่วนตัวและงานอีเวนต์
      </li>
      <li>
        เราขอสงวนสิทธิในการใช้ภาพตัวอย่างจากงาน (ที่ไม่ระบุตัวตนหรือได้รับความยินยอม)
        เพื่อการโปรโมตบริการบนเว็บไซต์ โซเชียลมีเดีย และสื่อการตลาด
        หากลูกค้าไม่ประสงค์ให้ใช้ กรุณาแจ้งล่วงหน้าเป็นลายลักษณ์อักษร
      </li>
      <li>
        การแชร์รูปผ่าน QR Code หรือ Cloud Gallery เป็นไปตามระยะเวลาและเงื่อนไขของแพ็กเกจ
      </li>
    </ul>

    <h2>7. อุปกรณ์และความรับผิดชอบ</h2>
    <ul>
      <li>เรานำอุปกรณ์ที่ได้รับการดูแลและทดสอบมาให้บริการ รวมถึงกล้อง DSLR ไฟสตูดิโอ และอุปกรณ์สนับสนุน</li>
      <li>เรามีทีมงานประจำจุดบริการเพื่อดูแลและแก้ไขปัญหาเบื้องต้นระหว่างงาน</li>
      <li>
        หากอุปกรณ์เสียหายจากการใช้งานปกติ เราจะดำเนินการแก้ไขหรือทดแทนตามความเหมาะสม
      </li>
      <li>
        หากอุปกรณ์เสียหายจากความประมาทหรือการกระทำของลูกค้าหรือแขก
        ลูกค้าอาจต้องรับผิดชอบค่าใช้จ่ายในการซ่อมหรือทดแทน
      </li>
      <li>
        เราไม่รับผิดชอบต่อความล่าช้าหรือการหยุดให้บริการอันเนื่องมาจากเหตุสุดวิสัย
        ปัญหาไฟฟ้าที่สถานที่ หรือข้อจำกัดของสถานที่ที่ลูกค้าไม่ได้แจ้งล่วงหน้า
      </li>
    </ul>

    <h2>8. การจำกัดความรับผิด</h2>
    <ul>
      <li>
        เราจะให้บริการด้วยความระมัดระวังและมาตรฐานวิชาชีพ
        แต่ไม่รับประกันว่างานจะปราศจากข้อผิดพลาดทางเทคนิคทั้งหมด
      </li>
      <li>
        ความรับผิดสูงสุดของเราต่อลูกค้าในทุกกรณีจะไม่เกินจำนวนเงินที่ลูกค้าชำระสำหรับบริการนั้น ๆ
      </li>
      <li>
        เราไม่รับผิดชอบต่อความเสียหายทางอ้อม ความเสียหายที่เป็นผลสืบเนื่อง
        หรือความเสียหายจากการสูญเสียโอกาสทางธุรกิจ
      </li>
    </ul>

    <h2>9. การใช้งานเว็บไซต์</h2>
    <p>
      การเข้าใช้เว็บไซต์ <a href={SITE.url}>{SITE.url}</a> และบริการออนไลน์ที่เกี่ยวข้อง
      (เช่น Cloud Gallery) ต้องปฏิบัติตามข้อกำหนดนี้และกฎหมายที่เกี่ยวข้อง
      ห้ามใช้เว็บไซต์เพื่อวัตถุประสงค์ที่ผิดกฎหมาย ละเมิดสิทธิของผู้อื่น
      หรือรบกวนการทำงานของระบบ
    </p>

    <h2>10. ทรัพย์สินทางปัญญา</h2>
    <p>
      เนื้อหา โลโก้ การออกแบบกรอบรูป ซอฟต์แวร์ และวัสดุส่งเสริมการขายบนเว็บไซต์และในระบบของเรา
      เป็นทรัพย์สินของ SNAP a FOTO หรือผู้ให้สิทธิ์ ห้ามคัดลอก ดัดแปลง หรือใช้เพื่อการค้าโดยไม่ได้รับอนุญาต
    </p>

    <h2>11. การแก้ไขข้อกำหนด</h2>
    <p>
      เราอาจปรับปรุงข้อกำหนดนี้เป็นครั้งคราว
      การเปลี่ยนแปลงจะมีผลเมื่อเผยแพร่บนหน้านี้
      การใช้บริการต่อเนื่องหลังการเปลี่ยนแปลงถือว่าท่านยอมรับข้อกำหนดฉบับใหม่
    </p>

    <h2>12. กฎหมายที่ใช้บังคับ</h2>
    <p>
      ข้อกำหนดนี้อยู่ภายใต้กฎหมายไทย
      ข้อพิพาทใด ๆ จะพยายามแก้ไขโดยการเจรจาเป็นอันดับแรก
      หากไม่สามารถตกลงกันได้ ให้อยู่ในเขตอำนาจศาลไทย
    </p>

    <h2>13. ติดต่อเรา</h2>
    <p>หากมีคำถามเกี่ยวกับข้อกำหนดการให้บริการ กรุณาติดต่อ:</p>
    <p>
      <strong>SNAP a FOTO</strong><br />
      อีเมล: <a href="mailto:snapafoto@yahoo.com">snapafoto@yahoo.com</a><br />
      โทรศัพท์: <a href="tel:0882667544">088-266-7544</a><br />
      LINE: @snapafoto<br />
      เว็บไซต์: <a href="/contact">ติดต่อเรา</a>
    </p>
  </LegalSection>
</MainLayout>
