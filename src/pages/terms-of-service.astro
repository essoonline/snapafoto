---
import MainLayout from '@/layouts/MainLayout.astro';
import LegalSection from '@components/sections/misc/LegalSection.astro';
import TermsOfServiceTh from '@components/sections/misc/legal/TermsOfServiceTh.astro';
import { SITE } from '@data/constants';

const pageTitle = `ข้อกำหนดการให้บริการ | ${SITE.title}`;
const metaDescription =
  'ข้อกำหนดและเงื่อนไขการให้บริการเช่าโฟโต้บูธ ตู้ถ่ายรูป และบริการอีเวนต์ของ SNAP a FOTO';
const ogTitle = `ข้อกำหนดการให้บริการ | SNAP a FOTO`;
const lastUpdated = '19 มิถุนายน 2569';
---

<MainLayout
  title={pageTitle}
  lang="th"
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${SITE.url}/terms-of-service`,
    url: `${SITE.url}/terms-of-service`,
    name: ogTitle,
    description: metaDescription,
    isPartOf: {
      '@type': 'WebSite',
      url: SITE.url,
      name: SITE.title,
      description: SITE.description,
    },
    inLanguage: 'th-TH',
  }}
>
  <LegalSection
    title="ข้อกำหนดการให้บริการ"
    lastUpdated={lastUpdated}
    alternateLang={{ label: 'English', url: '/en/terms-of-service' }}
  >
    <TermsOfServiceTh />
  </LegalSection>
</MainLayout>
