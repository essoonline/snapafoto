---
// Import the necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
import ClientsSection from '@components/sections/landing/ClientsSection.astro';
import FeaturesNavs from '@components/sections/features/FeaturesNavs.astro';
import TestimonialsSectionAlt from '@components/sections/testimonials/TestimonialsSectionAlt.astro';
import PricingSection from '@components/sections/pricing/PricingSection.astro';
import heroImage from '@images/hero-360.webp';
import pricing from '@data/pricing/360.json';
import features1 from '@images/360-features1.webp';
import features2 from '@images/360-features2.webp';
import features3 from '@images/360-features3.webp';
import video360_1 from '@images/360_1-web.mp4?url';
import video360_2 from '@images/360_2-web.mp4?url';
import video360_3 from '@images/360_3-web.mp4?url';
import video360_4 from '@images/360_4-web.mp4?url';
import testimonial1 from '@images/testimonials/1.webp';
import testimonial2 from '@images/testimonials/2.webp';
import testimonial3 from '@images/testimonials/3.webp';
import testimonial4 from '@images/testimonials/4.webp';
import testimonial5 from '@images/testimonials/5.webp';
import testimonial6 from '@images/testimonials/6.webp';
import testimonial7 from '@images/testimonials/7.webp';
import { partnersData, SITE } from '@/data_files/constants';

const avatarSrcs = [
  testimonial4,
  testimonial5,
  testimonial6,
  testimonial7,
];

const videos = [
  {
    title: 'งานแต่ง - 360 Photo Booth',
    src: video360_1,
  },
  {
    title: 'งานบริษัท - 360 Photo Booth',
    src: video360_2,
  },
  {
    title: 'งานปาร์ตี้ - 360 Photo Booth',
    src: video360_3,
  },
  {
    title: 'งานสัมมนา - 360 Photo Booth',
    src: video360_4,
  },
];

const pageTitle: string = `360 Photo Booth | ${SITE.title}`;
const metaDescription =
  'บริการ 360 Photo Booth สำหรับงานแต่ง งานอีเว้นท์ งานบริษัท และปาร์ตี้ พร้อมวิดีโอ Slow Motion เอฟเฟกต์สวย และทีมงานดูแลหน้างานโดย SNAP a FOTO';
const ogTitle = '360 Photo Booth | SNAP a FOTO';
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${SITE.url}/360`,
    url: `${SITE.url}/360`,
    name: ogTitle,
    description: metaDescription,
    isPartOf: {
      '@type': 'WebSite',
      url: SITE.url,
      name: SITE.title,
      description: SITE.description,
    },
    inLanguage: 'th-TH',
  }}
>
  <HeroSection
    title=`360 Photo Booth <span class="text-amber-700">หมุนรอบ ได้ทุกมุม</span>`
    subTitle="บันทึกทุกโมเมนต์แบบ Slow Motion วิดีโอสุดอลังการที่แขกทุกคนต้องแชร์"
    primaryBtn="จองคิว"
    primaryBtnURL="/contact"
    secondaryBtn="บริการทั้งหมด"
    secondaryBtnURL="/services"
    withReview={true}
    avatars={avatarSrcs}
    rating=`<span class="font-bold">4.9</span> / 5`
    starCount={4}
    reviews=`From Over <span class="font-bold">1k+</span> Reviews`
    src={heroImage}
    alt="360 Photo Booth บริการถ่ายรูปวิดีโอ 360 องศา โดย SNAP a FOTO"
  />

  <ClientsSection
    title="มั่นใจด้วยมาตรฐานที่องค์เลือกใช้"
    subTitle="Experience the reliability chosen by industry giants."
    partners={partnersData}
  />

  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="mx-auto mb-8 max-w-3xl text-center">
      <h2 class="text-2xl font-bold text-balance text-neutral-800 md:text-3xl">
        360 องศา ทุกมุม ทุกความทรงจำ
      </h2>
      <p class="mt-2 text-pretty text-neutral-600 md:mt-4">
        360 Photo Booth ของเรา เราเข้าใจความต้องการที่หลากหลายของงานอีเวนต์ ไม่ว่าจะเป็นงานแต่ง งานบริษัท หรืองานปาร์ตี้ เราพร้อมมอบทั้งอุปกรณ์ทันสมัย และบริการแบบมืออาชีพ เพื่อให้ทุกช่วงเวลาเต็มไปด้วยความสนุก และวิดีโอ 360 องศาที่น่าประทับใจ
      </p>
    </div>

    <div class="grid gap-6 grid-cols-2 lg:grid-cols-4">
      {
        videos.map((video) => (
          <div class="overflow-hidden rounded-2xl border border-neutral-300 bg-neutral-100 shadow-sm">
            <div class="w-full bg-black cursor-pointer group aspect-video" data-video-container>
              <video
                class="h-full w-full"
                data-video-element
                preload="none"
                playsinline
                muted
              >
                <source data-video-source data-src={video.src} type="video/mp4" />
                Your browser does not support the video tag.
              </video>
            </div>
          </div>
        ))
      }
    </div>

    <script>
      document.querySelectorAll('[data-video-container]').forEach((containerElement) => {
        const container = containerElement as HTMLElement;
        const video = container.querySelector('[data-video-element]') as HTMLVideoElement;
        const source = video?.querySelector('[data-video-source]') as HTMLSourceElement | null;

        const loadVideo = () => {
          if (!video || !source || !source.dataset.src || source.src) return;
          source.src = source.dataset.src;
          video.load();
        };

        if (video) {
          // Keep all preview videos silent.
          video.muted = true;
          video.preload = 'metadata';

          if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver(
              (entries, currentObserver) => {
                entries.forEach((entry) => {
                  if (entry.isIntersecting) {
                    loadVideo();
                    currentObserver.unobserve(entry.target);
                  }
                });
              },
              { rootMargin: '150px 0px' }
            );

            observer.observe(container);
          } else {
            loadVideo();
          }

          // Play/pause on click
          container.addEventListener('click', () => {
            if (video.paused) {
              loadVideo();
              video.play();
            } else {
              video.pause();
            }
          });

          // Adjust container aspect ratio based on video dimensions
          const updateAspectRatio = () => {
            if (video.videoWidth && video.videoHeight) {
              const aspectRatio = video.videoWidth / video.videoHeight;
              container.style.aspectRatio = aspectRatio.toString();
            }
          };

          // Listen for metadata loaded
          video.addEventListener('loadedmetadata', updateAspectRatio);
          
          // Try immediately if already loaded
          if (video.readyState >= 1) {
            updateAspectRatio();
          }
        }
      });
    </script>
  </section>

  <FeaturesNavs
    title={`ทำไม <span class="text-amber-700">360 Photo Booth</span> ของเราถึงเหมาะกับทุกงาน`}
    tabs={[
      {
        heading: 'แท่น 360 มาตรฐาน รองรับได้ทุกขนาดงาน',
        content:
          'แท่นหมุน 360 องศา ขนาดใหญ่ รองรับได้ถึง 2-4 คน พร้อมอาร์มกล้องและชุดไฟ LED รอบแท่น ให้คลิปออกมาสวย สด ทุกมุม',
        svg: 'camera',
        src: features1,
        alt: 'แท่น 360 Photo Booth พร้อมชุดไฟ LED สำหรับงานอีเวนต์',
        first: true,
      },
      {
        heading: 'ใช้งานง่าย สนุกได้ทันที',
        content:
          'ไม่ต้องมีประสบการณ์ก็เล่นได้ Staff ประจำบูธคอยดูแลและกำกับท่าทางให้ ได้คลิปสวยทุกครั้งที่ขึ้นแท่น',
        svg: 'smile',
        src: features2,
        alt: 'Staff ดูแล 360 Photo Booth ในงานอีเวนต์',
      },
      {
        heading: 'ครบทุกฟีเจอร์ที่ต้องมี',
        content:
          'ทั้ง Slow Motion เพลงประกอบ Overlay ชื่องาน และแชร์คลิปผ่าน QR Code ให้แขกได้วิดีโอกลับบ้านเป็นความทรงจำทันที',
        svg: 'printer',
        src: features3,
        alt: 'ฟีเจอร์ 360 Photo Booth Slow Motion และแชร์ QR Code',
      },
    ]}
  />

  <TestimonialsSectionAlt
    title="รีวิวจริงลูกค้าที่ใช้บริการ"
    testimonials={[
      {
        content:
          'ขอบคุณทีมงาน SNAP a FOTO มากๆค่ะ ดูแลดีมากเลยค่ะ มีพร็อพถ่ายรูปเยอะมากๆ แขกในงาน คุณพ่อ คุณแม่ ลุงๆป้าๆ สนุกกันมากเลยค่ะ ได้ภาพสวยๆเป็นที่ระลึกกับบ้านทุกคนเลย ไม่ผิดหวังที่เลือกใช้บริการค่ะ ประทับใจมากค่ะ ขอบคุณนร้าคร้าาาา🥰🥰🥰',
        author: 'Avanew Plus',
        role: 'Facebook',
        avatarSrc: testimonial1,
        avatarAlt: 'Avanew Plus portrait',
      },
      {
        content:
          'เป็นบูธที่สนุกที่สุดในงาน แขกไม่เหงาเลย เดินถ่ายแบบบุฟเฟ่ต์ ภาพสวย เทมเพลตแก้ได้ตลอด ไม่ถูกใจก็แก้ได้เรื่อยๆ มีqr code ให้โหลดและอัพลงโซเชียลได้เลย สะดวกมาก ราคาย่อมเยาว์มาก งานแต่งต้องมีนะคะ ร้านนี้คุยง่าย แนะนำค่า ❤️❤️❤️❤️❤️',
        author: 'Pimjira Suksao',
        role: 'Facebook',
        avatarSrc: testimonial2,
        avatarAlt: 'Pimjira Suksao portrait',
      },
      {
        content:
          'ขอบคุณทีมงานโฟโต้บูธมากๆนะคะ งานดูมีสีสันขึ้นมากเลย พร็อพถ่ายรูปมีให้เลือกเล่นเยอะแยะมากมาย แขกในงานสนุกสนานกันทุกคน ทีมงานบริการดี ดูแลดี เชิญแขกถ่ายรูปให้ตลอด ดูแลแบบมืออาชีพจริงๆค่ะ ไว้มีโอกาสอื่นๆจะมาใช้บริการใหม่นะคะ',
        author: 'Chartparamee Chaiyadej',
        role: 'Google',
        avatarSrc: testimonial3,
        avatarAlt: 'Chartparamee Chaiyadej portrait',
      },
    ]}
  />

  <PricingSection pricing={pricing} />

  <section class="mx-auto max-w-[85rem] px-4 pt-10 pb-24 sm:px-6 lg:px-8">
    <div class="mx-auto mb-8 max-w-3xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-neutral-800 md:text-5xl">
        Video Presentation
      </h2>
      <p class="mt-4 text-lg text-neutral-600">
        ดูตัวอย่างการใช้งาน PhotoBooth ของเราผ่านวิดีโอด้านล่าง
      </p>
    </div>

    <div class="mx-auto max-w-5xl overflow-hidden rounded-2xl border border-neutral-300 bg-neutral-100 shadow-sm">
      <div class="aspect-video w-full relative" id="video-cover-container-360">
        <script type="text/javascript">
          function loadVideo360() {
            const container = document.getElementById('video-cover-container-360');
            container.innerHTML = `<iframe
              class='h-full w-full'
              src='https://www.youtube-nocookie.com/embed/VO-VDh-M7z0?autoplay=1'
              title='PhotoBooth video presentation'
              loading='lazy'
              allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
              referrerpolicy='strict-origin-when-cross-origin'
              allowfullscreen
            ></iframe>`;
          }
        </script>
        <button type="button" onclick="loadVideo360()" class="absolute inset-0 w-full h-full focus:outline-none group">
          <img src="https://img.youtube.com/vi/VO-VDh-M7z0/maxresdefault.jpg" alt="PhotoBooth 360 video cover" class="h-full w-full object-cover rounded-2xl border-0" loading="lazy" />
          <span class="absolute inset-0 flex items-center justify-center">
            <svg class="w-20 h-20 text-white/80 group-hover:text-yellow-400 transition" fill="currentColor" viewBox="0 0 84 84">
              <circle cx="42" cy="42" r="42" fill="black" fill-opacity="0.5"/>
              <polygon points="34,28 62,42 34,56" fill="white"/>
            </svg>
          </span>
        </button>
      </div>
    </div>
  </section>
</MainLayout>
