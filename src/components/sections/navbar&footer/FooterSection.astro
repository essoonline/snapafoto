---
// Import the necessary dependencies
import FooterSocialLink from '@components/ui/links/FooterSocialLink.astro';
import EmailFooterInput from '@components/ui/forms/input/EmailFooterInput.astro';

import enStrings, { legalLinks } from '@utils/navigation.ts';
import Icon from '@components/ui/icons/Icon.astro';
import BrandLogo from '@components/BrandLogo.astro';

const strings = enStrings;
---

<footer class="w-full bg-neutral-300">
  <div
    class="mx-auto w-full max-w-[85rem] px-4 py-10 sm:px-6 lg:px-16 lg:pt-20 2xl:max-w-(--breakpoint-2xl)"
  >
    <div class="grid grid-cols-2 gap-6 md:grid-cols-4 lg:grid-cols-5">
      <div class="col-span-full lg:col-span-1">
        {/* Brand Logo */}
        <BrandLogo class="h-auto w-36" />
      </div>
      {/* An array of links for Product and Company sections */}
      {
        strings.footerLinks.map(section => (
          <div class="col-span-1">
            <h3 class="font-bold text-neutral-800">
              {section.section}
            </h3>
            <ul class="mt-3 grid space-y-3">
              {section.links.map((link, index) => (
                <li>
                  <a
                    href={link.url}
                    class="inline-flex gap-x-2 rounded-lg text-neutral-600 ring-zinc-500 outline-hidden transition duration-300 hover:text-neutral-500 focus-visible:ring-3"
                  >
                    {link.name}
                  </a>
                  {section.section === 'Company' && index === 2 ? (
                    <span class="ms-1 inline rounded-lg bg-orange-700 px-2 py-1 text-xs font-bold text-white">
                      Fast!
                    </span>
                  ) : null}
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="col-span-2">
        <h3 class="font-bold text-neutral-800">Stay up to date</h3>

        <form
          toolname="subscribe_updates"
          tooldescription="Subscribe to SNAP a FOTO updates by providing an email address and opening the Facebook Messenger chat."
          action="https://m.me/snapafoto"
          method="get"
          target="_blank"
        >
          <EmailFooterInput />
        </form>

        <div class="mt-3">
          <FooterSocialLink url={strings.socialLinks.email}
            ><Icon name="emailFooter" />
          </FooterSocialLink>

          <FooterSocialLink url={strings.socialLinks.instagram}
            ><Icon name="instagramFooter" /></FooterSocialLink
          >

          <FooterSocialLink url={strings.socialLinks.youtube}
            ><Icon name="youtubeFooter" />
          </FooterSocialLink>
        </div>
      </div>
    </div>

    <div
      class="mt-9 grid gap-y-2 sm:mt-12 sm:flex sm:items-center sm:justify-between sm:gap-y-0"
    >
      <p class="text-sm text-neutral-600">
        © <span id="current-year"></span> SNAP a FOTO
      </p>

      <nav
        class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-neutral-600"
        aria-label="Legal"
      >
        {
          legalLinks.map(link => (
            <a
              href={link.url}
              class="transition duration-300 hover:text-neutral-500"
            >
              {link.name}
            </a>
          ))
        }
      </nav>
    </div>

    <script>
      const year = new Date().getFullYear();
      const element = document.getElementById('current-year');
      element!.innerText = year.toString();
    </script>
  </div>
</footer>
