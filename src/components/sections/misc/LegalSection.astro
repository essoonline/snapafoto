---
interface Props {
  title: string;
  lastUpdated: string;
  lastUpdatedLabel?: string;
  alternateLang?: { label: string; url: string };
}

const {
  title,
  lastUpdated,
  lastUpdatedLabel = 'อัปเดตล่าสุด',
  alternateLang,
} = Astro.props;
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-3xl">
    <header class="mb-10 text-center">
      {
        alternateLang ? (
          <div class="mb-4 flex justify-center">
            <a
              href={alternateLang.url}
              class="inline-flex items-center rounded-lg border border-neutral-400 bg-neutral-100 px-4 py-2 text-sm font-medium text-neutral-700 transition duration-300 hover:border-yellow-500 hover:text-neutral-900"
            >
              {alternateLang.label}
            </a>
          </div>
        ) : null
      }
      <h1
        class="text-2xl font-bold tracking-tight text-balance text-neutral-800 md:text-4xl md:leading-tight"
      >
        {title}
      </h1>
      <p class="mt-3 text-sm text-neutral-500">
        {lastUpdatedLabel}: {lastUpdated}
      </p>
    </header>

    <article
      class="prose prose-neutral max-w-none prose-headings:font-bold prose-headings:text-neutral-800 prose-p:text-neutral-600 prose-li:text-neutral-600 prose-a:text-yellow-600 prose-a:no-underline hover:prose-a:underline"
    >
      <slot />
    </article>
  </div>
</section>
