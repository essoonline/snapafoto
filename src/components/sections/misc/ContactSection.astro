---
import ReviewComponent from '@components/ui/blocks/ReviewComponent.astro';
import SecondaryCTA from '@components/ui/buttons/SecondaryCTA.astro';
import { partnersData } from '@/data_files/constants';
import { Image } from 'astro:assets';
import testimonial4 from '@images/testimonials/4.webp';
import testimonial5 from '@images/testimonials/5.webp';
import testimonial6 from '@images/testimonials/6.webp';
import testimonial7 from '@images/testimonials/7.webp';

// Define the variables that will be used in this component
const title: string = 'Contact us';
const avatarSrcs = [
  testimonial4,
  testimonial5,
  testimonial6,
  testimonial7,
];
---

{/* Contact Us */}
<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-2xl lg:max-w-5xl">
    <div class="text-center">
      <h1
        class="text-2xl font-bold tracking-tight text-balance text-neutral-800 md:text-4xl md:leading-tight"
      >
        {title}
      </h1>
      <div class="flex justify-center">
        <ReviewComponent
          avatars={avatarSrcs}
          rating={`<span class="font-bold">4.9</span> / 5`}
          starCount={4}
          reviews={`From Over <span class="font-bold">1k+</span> Reviews`}
        />
      </div>
    </div>

    <article class="mx-auto mt-8 max-w-4xl text-neutral-600">
      <div class="mt-5 space-y-4 text-pretty text-center leading-7">
        <p>
          ตั้งขึ้นเมื่อวันที่ 16 ธันวาคม 2562 โดยมีวัตถุประสงค์ในการให้บริการด้านการถ่ายภาพและเทคโนโลยีสมัยใหม่
          ไม่ว่าจะเป็น Photo Booth งานแต่งงาน, 360 องศา งานอีเวนต์, ระบบถ่ายภาพด้วย AI, บริการพิมพ์ภาพ
          (Instant Print) และโซลูชันด้านการถ่ายภาพแบบครบวงจร
        </p>
        <p>
          สิ่งที่เราคำนึงถึงมากที่สุด คือ คุณภาพของภาพถ่าย ความประทับใจ และความต่อเนื่องของบริการ
          เพื่อให้งานอีเวนต์หรือกิจกรรมของลูกค้าเต็มไปด้วยรอยยิ้ม ความสนุกสนาน และความทรงจำที่ดีที่สุด
          เรามุ่งมั่นที่จะพัฒนาและนำเสนอเทคโนโลยีใหม่ ๆ มาตอบสนองความต้องการของลูกค้าอย่างต่อเนื่อง
        </p>
        <p>
          ด้วยประสบการณ์ในการทำงานด้าน การถ่ายภาพอีเวนต์และระบบถ่ายภาพอัตโนมัติ เราเข้าใจปัญหา ความต้องการ
          และรายละเอียดที่แตกต่างกันของแต่ละงาน เราจึงให้ความใส่ใจตั้งแต่การออกแบบ Photo Booth, การเลือกอุปกรณ์,
          ไปจนถึงการพัฒนาระบบ AI เพื่อสร้างความแตกต่างและตรงกับความต้องการของลูกค้าอย่างแท้จริง
        </p>
        <p>
          เรายึดมั่นในคุณภาพและมาตรฐานของงาน พร้อมสโลแกนของเราที่ว่า
          <strong>“If you want quality memories”</strong>
        </p>
        <p>
          เราขอขอบพระคุณลูกค้าทุกท่านที่ไว้วางใจในบริการถ่ายภาพและผลิตภัณฑ์ของเรา
          ประสบการณ์ที่สะสมมาตลอดหลายปีจะถูกนำมาใช้เพื่อปรับปรุงและพัฒนางานบริการของเราให้ดียิ่งขึ้น
          เพื่อสร้างความทรงจำที่สวยงามและตรงใจลูกค้ามากที่สุด
        </p>
      </div>
    </article>

    <section class="mt-8 px-4 pt-0 pb-10 sm:px-6 lg:px-8 lg:pt-0 lg:pb-14">
      <div class="mx-auto w-full max-w-4xl text-center">
        <div class="pt-10 lg:pt-14">
          <div class="mx-auto mb-6 w-full space-y-1 text-center sm:w-1/2 lg:w-1/3">
            <h2 class="text-2xl leading-tight font-bold text-balance text-neutral-800 sm:text-3xl">
              การติดต่อ
            </h2>
          </div>

          <div class="mx-auto grid max-w-4xl gap-3 text-left md:grid-cols-3">
            <a
              href="https://m.me/snapafoto"
              target="_blank"
              rel="noopener noreferrer"
                class="relative block rounded-xl bg-[#1877F2]/10 p-4 pb-12 shadow-sm ring-1 ring-[#1877F2]/25 transition duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#1877F2]/60"
            >
              <div class="flex items-start gap-3">
                <span class="inline-flex shrink-0 items-center justify-center text-[#1877F2]">
                  <svg class="h-10 w-10 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z" />
                  </svg>
                </span>
                <div>
                  <p class="text-xs font-semibold tracking-wide text-[#1877F2]">Facebook</p>
                  <p class="mt-1 text-sm font-medium text-neutral-800 sm:text-base">SNAP a FOTO</p>
                </div>
              </div>
              <span class="absolute right-0 bottom-0 inline-flex items-center rounded-tl-xl rounded-br-xl bg-[#1877F2] px-2.5 py-1 text-xs font-semibold text-white">Follow 4.4k</span>
            </a>
            <a
              href="https://lin.ee/VOh3AuJ"
              target="_blank"
              rel="noopener noreferrer"
                class="relative block rounded-xl bg-[#06C755]/10 p-4 pb-12 shadow-sm ring-1 ring-[#06C755]/25 transition duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#06C755]/60"
            >
              <div class="flex items-start gap-3">
                <span class="inline-flex shrink-0 items-center justify-center text-[#06C755]">
                  <svg class="h-11 w-11" viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="2.5" y="3.5" width="19" height="17" rx="5" fill="currentColor"></rect>
                    <path d="M9.5 20.5 8.6 17.8h6.8L14.5 20.5" fill="currentColor"></path>
                    <text x="12" y="14" text-anchor="middle" font-size="5.5" font-weight="700" fill="white">LINE</text>
                  </svg>
                </span>
                <div>
                  <p class="text-xs font-semibold tracking-wide text-[#06C755]">LINE Official</p>
                  <p class="mt-1 text-sm font-medium text-neutral-800 sm:text-base">@snapafoto</p>
                </div>
              </div>
              <span class="absolute right-0 bottom-0 inline-flex items-center rounded-tl-xl rounded-br-xl bg-[#06C755] px-2.5 py-1 text-xs font-semibold text-white">Follow 1.4k</span>
            </a>
            <a
              href="https://m.me/photobooth.th"
              target="_blank"
              rel="noopener noreferrer"
                class="relative block rounded-xl bg-[#1877F2]/10 p-4 pb-12 shadow-sm ring-1 ring-[#1877F2]/25 transition duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#1877F2]/60"
            >
              <div class="flex items-start gap-3">
                <span class="inline-flex shrink-0 items-center justify-center text-[#1877F2]">
                  <svg class="h-10 w-10 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z" />
                  </svg>
                </span>
                <div>
                  <p class="text-xs font-semibold tracking-wide text-[#1877F2]">Facebook</p>
                  <p class="mt-1 text-sm font-medium text-neutral-800 sm:text-base">
                    Photobooth Chiangmai : โฟโต้บูธเชียงใหม่ งานแต่ง และอีเว้นท์
                  </p>
                </div>
              </div>
              <span class="absolute right-0 bottom-0 inline-flex items-center rounded-tl-xl rounded-br-xl bg-[#1877F2] px-2.5 py-1 text-xs font-semibold text-white">Follow 1.1k</span>
            </a>
          </div>

          <div class="mt-6 flex items-center justify-center">
            <SecondaryCTA title="ติดต่อเร่งด่วนโทร.088-266-7544" url="tel:0882667544" />
          </div>
        </div>

        <div class="pt-10 lg:pt-14">
          <div class="mx-auto mb-6 w-full max-w-4xl space-y-1 text-center">
            <h2 class="text-2xl leading-tight font-bold text-balance text-neutral-800 sm:text-3xl">
              มั่นใจด้วยมาตรฐานที่องค์เลือกใช้
            </h2>
            <p class="leading-tight text-pretty text-neutral-600">
              Experience the reliability chosen by industry giants.
            </p>
          </div>

          <div
            class="flex flex-row items-center justify-center gap-x-4 gap-y-0 sm:gap-x-12 lg:gap-x-24"
          >
            {
              partnersData.map((partner) => (
                <Image
                  src={partner.imageSrc}
                  alt={partner.alt ?? `${partner.name ?? 'Partner'} logo`}
                  class="mx-auto h-auto w-16 py-3 sm:mx-0 sm:w-24 md:w-32 lg:w-40 lg:py-5"
                  loading="lazy"
                  decoding="async"
                  widths={[64, 96, 128, 160]}
                  sizes="(max-width: 640px) 64px, (max-width: 768px) 96px, (max-width: 1024px) 128px, 160px"
                  format="webp"
                />
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </div>
</section>
