---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Define props from Astro
const { title, subTitle, partners } = Astro.props;

interface Partner {
  icon?: any;
  imageSrc?: ImageMetadata;
  alt?: string;
  name?: string;
  href?: string;
}

// Define TypeScript interface for props
interface Props {
  title: string;
  subTitle?: string;
  partners: Partner[];
}
---

<section
  class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
>
  {/* Title and description */}
  <div class="mx-auto mb-6 w-full space-y-1 text-center sm:w-1/2 lg:w-1/3">
    <h2
      class="text-2xl leading-tight font-bold text-balance text-neutral-800 sm:text-3xl"
    >
      {title}
    </h2>
    {
      subTitle && (
        <p class="leading-tight text-pretty text-neutral-600">
          {subTitle}
        </p>
      )
    }
  </div>
  <div
    class="flex flex-row items-center justify-center gap-x-4 gap-y-0 sm:gap-x-12 lg:gap-x-24"
  >
    {/* Clients Group logos */}
    {
      partners.map(partner => (
        partner.imageSrc ? (
          <Image
            src={partner.imageSrc}
            alt={partner.alt ?? `${partner.name ?? 'Partner'} logo`}
            class="mx-auto h-auto w-16 py-3 sm:mx-0 sm:w-24 md:w-32 lg:w-40 lg:py-5"
            loading="lazy"
            decoding="async"
            widths={[64, 96, 128, 160]}
            sizes="(max-width: 640px) 64px, (max-width: 768px) 96px, (max-width: 1024px) 128px, 160px"
            format="webp"
          />
        ) : (
          <div set:html={partner.icon} />
        )
      ))
    }
  </div>
</section>
