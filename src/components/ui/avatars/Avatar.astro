---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const { src, alt } = Astro.props;

interface Props {
  src: string | ImageMetadata;
  alt: string;
}
---

{
  typeof src === 'string' ? (
    <Image
      class="inline-block h-8 w-8 rounded-full ring-2 ring-neutral-50"
      src={src}
      alt={alt}
      inferSize
      loading={'eager'}
    />
  ) : (
    <Image
      class="inline-block h-8 w-8 rounded-full ring-2 ring-neutral-50"
      src={src}
      alt={alt}
      loading={'eager'}
    />
  )
}
