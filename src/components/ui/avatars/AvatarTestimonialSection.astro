---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const { src, alt } = Astro.props;

interface Props {
  src: string | ImageMetadata;
  alt: string;
}
---

<div class="shrink-0">
  {
    typeof src === 'string' ? (
      <img
        class="size-8 rounded-full sm:h-[2.875rem] sm:w-[2.875rem]"
        src={src}
        alt={alt}
        loading="lazy"
        decoding="async"
        width="46"
        height="46"
      />
    ) : (
      <Image
        class="size-8 rounded-full sm:h-[2.875rem] sm:w-[2.875rem]"
        src={src}
        alt={alt}
        loading="lazy"
        widths={[32, 46, 64]}
        sizes="(max-width: 640px) 32px, 46px"
        format="webp"
      />
    )
  }
</div>
