---
const { url, label } = Astro.props;
interface Props {
  url: string;
  label: string;
}
const brandBackgrounds: Record<string, string> = {
  Facebook: 'bg-[#1877F2]',
  Instagram: 'bg-gradient-to-br from-[#FCAF45] via-[#E1306C] to-[#833AB4]',
  YouTube: 'bg-[#FF0033]',
  LINE: 'bg-[#06C755]',
};
const linkClass = `inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-md outline-hidden transition-transform hover:scale-110 focus-visible:ring-3 focus-visible:ring-zinc-500 ${brandBackgrounds[label] ?? ''}`;
---

<a class={linkClass} href={url} aria-label={label} target="_blank" rel="noopener noreferrer">
  <slot />
</a>
