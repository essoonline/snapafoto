---
import Icon from '@components/ui/icons/Icon.astro';
import { productNavHref } from '@utils/navigation.ts';

const { label = 'AI', href = productNavHref } = Astro.props;

interface Props {
  label?: string;
  href?: string;
}

const isExternal = (url: string) => url.startsWith('http');
---

<a
  href={href}
  class="flex items-center gap-x-1 rounded-lg px-1.5 py-0.5 text-base font-medium text-neutral-700 ring-zinc-500 outline-hidden transition duration-300 hover:bg-neutral-200 hover:text-orange-700 focus-visible:ring-3 md:py-1 md:text-sm 2xl:text-base"
  target={isExternal(href) ? '_blank' : undefined}
  rel={isExternal(href) ? 'noopener noreferrer' : undefined}
>
  <span class="shrink-0" aria-hidden="true">
    <Icon name="sparks" />
  </span>
  {label}
</a>
