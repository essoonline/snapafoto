---
const {
  label = 'Email',
  title = 'Subscribe',
  id = 'footer-input',
  placeholder = 'Enter your email',
} = Astro.props;

interface Props {
  label?: string;
  title?: string;
  id?: string;
  placeholder?: string;
}
---

<div
  class="mt-4 flex flex-col items-center gap-2 rounded-lg bg-neutral-200 p-2 sm:flex-row sm:gap-3"
>
  <div class="w-full">
    <label for={id} class="sr-only">{label}</label>
    <input
      type="email"
      id={id}
      name="email"
      toolparamdescription="Email address for newsletter and update notifications."
      class="block w-full rounded-lg border-transparent bg-neutral-100 px-4 py-3 text-sm text-neutral-600 caret-orange-400 focus:border-orange-400 focus:ring-orange-400 disabled:pointer-events-none disabled:opacity-50"
      placeholder={placeholder}
      required
    />
  </div>
  <button
    type="submit"
    class="inline-flex w-full items-center justify-center gap-x-2 rounded-lg border border-transparent bg-orange-600 p-3 text-sm font-bold whitespace-nowrap text-white ring-zinc-500 outline-hidden transition duration-300 hover:bg-orange-700 focus-visible:ring-3 disabled:pointer-events-none disabled:opacity-50 sm:w-auto"
  >
    {title}
  </button>
</div>
