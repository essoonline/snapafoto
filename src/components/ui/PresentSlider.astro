---
interface SlideImage {
  src: string;
  alt: string;
}

interface Props {
  images: SlideImage[];
}

const { images } = Astro.props;
---

<div class="present-slider relative w-full" data-present-slider>
  <div class="present-slider__frame relative overflow-hidden rounded-2xl border border-neutral-300 bg-neutral-100 shadow-sm">
    {
      images.map((image, index) => (
        <img
          src={image.src}
          alt={image.alt}
          data-slide-index={index}
          class:list={[
            'present-slider__slide pointer-events-none block h-auto w-full select-none transition-opacity duration-300',
            index === 0
              ? 'relative z-0 opacity-100'
              : 'absolute inset-x-0 top-0 z-0 opacity-0',
          ]}
          loading={index === 0 ? 'eager' : 'lazy'}
          draggable="false"
        />
      ))
    }

    {
      images.length > 1 && (
        <button
          type="button"
          class="present-slider__hit absolute inset-0 z-20 border-0 bg-transparent p-0"
          aria-label="Change slide"
        >
          <span
            class="present-slider__cursor-arrow pointer-events-none absolute flex h-11 w-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-black/50 text-white opacity-0 shadow-lg sm:h-14 sm:w-14"
            aria-hidden="true"
          >
            <svg
              class="present-slider__icon present-slider__icon--prev h-6 w-6 sm:h-8 sm:w-8"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m15 18-6-6 6-6"></path>
            </svg>
            <svg
              class="present-slider__icon present-slider__icon--next hidden h-6 w-6 sm:h-8 sm:w-8"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </span>
        </button>
      )
    }
  </div>
</div>

<style is:global>
  .present-slider__hit {
    cursor: none;
  }

  .present-slider__hit.is-active {
    cursor: none;
  }

  .present-slider__hit.is-active .present-slider__cursor-arrow {
    opacity: 1;
  }
</style>

<script>
  const initPresentSliders = () => {
    document.querySelectorAll<HTMLElement>('[data-present-slider]').forEach((root) => {
      if (root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const frame = root.querySelector<HTMLElement>('.present-slider__frame');
      const slides = [...root.querySelectorAll<HTMLImageElement>('.present-slider__slide')];
      const hit = root.querySelector<HTMLButtonElement>('.present-slider__hit');
      const arrow = root.querySelector<HTMLElement>('.present-slider__cursor-arrow');
      const iconPrev = root.querySelector<SVGElement>('.present-slider__icon--prev');
      const iconNext = root.querySelector<SVGElement>('.present-slider__icon--next');
      if (!frame || !hit || !arrow || slides.length <= 1) return;

      let current = 0;

      const show = (index: number) => {
        current = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          const active = i === current;
          slide.classList.toggle('relative', active);
          slide.classList.toggle('absolute', !active);
          slide.classList.toggle('inset-x-0', !active);
          slide.classList.toggle('top-0', !active);
          slide.classList.toggle('opacity-100', active);
          slide.classList.toggle('opacity-0', !active);
        });
      };

      const moveArrow = (event: MouseEvent) => {
        const rect = frame.getBoundingClientRect();
        const x = event.clientX - rect.left;
        const y = event.clientY - rect.top;
        const isLeft = x < rect.width / 2;

        arrow.style.left = `${x}px`;
        arrow.style.top = `${y}px`;

        iconPrev?.classList.toggle('hidden', !isLeft);
        iconNext?.classList.toggle('hidden', isLeft);
      };

      hit.addEventListener('mouseenter', (event) => {
        hit.classList.add('is-active');
        moveArrow(event);
      });
      hit.addEventListener('mousemove', moveArrow);
      hit.addEventListener('mouseleave', () => {
        hit.classList.remove('is-active');
      });
      hit.addEventListener('click', (event) => {
        const rect = frame.getBoundingClientRect();
        const isLeft = event.clientX - rect.left < rect.width / 2;
        show(isLeft ? current - 1 : current + 1);
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPresentSliders);
  } else {
    initPresentSliders();
  }
</script>
